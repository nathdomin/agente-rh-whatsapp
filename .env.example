# Copie para .env e preencha. Nunca publique o .env.

# Meta for Developers > seu app > WhatsApp > Etapa 1. Experimente
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Meta for Developers > seu app > Configurações do app > Básico
META_APP_SECRET=
# Invente um texto longo; o mesmo valor vai na tela de webhook da Meta
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# console.groq.com > API Keys
GROQ_API_KEY=
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# Supabase > Project Settings > API (usados pelos scripts locais)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Invente um texto longo; o mesmo valor vai nas propriedades do Apps Script
SHEETS_SECRET=

COMPANY_NAME=Empresa Exemplo
DISMISSAL_EMAIL=rh@empresa-exemplo.example
MONTHLY_CAP=950
TIMEZONE=America/Sao_Paulo
